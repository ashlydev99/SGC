<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SGC" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.SGC.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E1B2E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_image</item>
        <item name="postSplashScreenTheme">@style/Theme.SGC</item>
    </style>
</resources>